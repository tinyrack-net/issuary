{
  "name": "@tinyauth/backend",
  "version": "1.0.0",
  "type": "module",
  "description": "OpenID Connect Provider with OAuth2 support",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://git.winetree94.com/tinyrack/auth.git",
    "directory": "packages/backend"
  },
  "files": [
    "public",
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/entries/index.d.ts",
        "default": "./dist/entries/index.js"
      },
      "./config": {
        "types": "./dist/entries/config/index.d.ts",
        "default": "./dist/entries/config/index.js"
      },
      "./services": {
        "types": "./dist/entries/services.d.ts",
        "default": "./dist/entries/services.js"
      },
      "./database/postgres": {
        "types": "./dist/entries/database/postgres.d.ts",
        "default": "./dist/entries/database/postgres.js"
      },
      "./database/sqlite": {
        "types": "./dist/entries/database/sqlite.d.ts",
        "default": "./dist/entries/database/sqlite.js"
      },
      "./mail/nodemailer": {
        "types": "./dist/entries/mail/nodemailer.d.ts",
        "default": "./dist/entries/mail/nodemailer.js"
      },
      "./identity-providers/github": {
        "types": "./dist/entries/identity-providers/github.d.ts",
        "default": "./dist/entries/identity-providers/github.js"
      },
      "./identity-providers/google": {
        "types": "./dist/entries/identity-providers/google.d.ts",
        "default": "./dist/entries/identity-providers/google.js"
      },
      "./identity-providers/apple": {
        "types": "./dist/entries/identity-providers/apple.d.ts",
        "default": "./dist/entries/identity-providers/apple.js"
      },
      "./identity-providers/generic-oauth": {
        "types": "./dist/entries/identity-providers/generic-oauth.d.ts",
        "default": "./dist/entries/identity-providers/generic-oauth.js"
      }
    },
    "imports": {
      "#backend/*": {
        "types": "./dist/*",
        "default": "./dist/*"
      }
    }
  },
  "exports": {
    ".": {
      "@tinyauth/source": "./src/entries/index.ts",
      "types": "./dist/entries/index.d.ts",
      "default": "./dist/entries/index.js"
    },
    "./config": {
      "@tinyauth/source": "./src/entries/config/index.ts",
      "types": "./dist/entries/config/index.d.ts",
      "default": "./dist/entries/config/index.js"
    },
    "./services": {
      "@tinyauth/source": "./src/entries/services.ts",
      "types": "./dist/entries/services.d.ts",
      "default": "./dist/entries/services.js"
    },
    "./database/postgres": {
      "@tinyauth/source": "./src/entries/database/postgres.ts",
      "types": "./dist/entries/database/postgres.d.ts",
      "default": "./dist/entries/database/postgres.js"
    },
    "./database/sqlite": {
      "@tinyauth/source": "./src/entries/database/sqlite.ts",
      "types": "./dist/entries/database/sqlite.d.ts",
      "default": "./dist/entries/database/sqlite.js"
    },
    "./mail/nodemailer": {
      "@tinyauth/source": "./src/entries/mail/nodemailer.ts",
      "types": "./dist/entries/mail/nodemailer.d.ts",
      "default": "./dist/entries/mail/nodemailer.js"
    },
    "./identity-providers/github": {
      "@tinyauth/source": "./src/entries/identity-providers/github.ts",
      "types": "./dist/entries/identity-providers/github.d.ts",
      "default": "./dist/entries/identity-providers/github.js"
    },
    "./identity-providers/google": {
      "@tinyauth/source": "./src/entries/identity-providers/google.ts",
      "types": "./dist/entries/identity-providers/google.d.ts",
      "default": "./dist/entries/identity-providers/google.js"
    },
    "./identity-providers/apple": {
      "@tinyauth/source": "./src/entries/identity-providers/apple.ts",
      "types": "./dist/entries/identity-providers/apple.d.ts",
      "default": "./dist/entries/identity-providers/apple.js"
    },
    "./identity-providers/generic-oauth": {
      "@tinyauth/source": "./src/entries/identity-providers/generic-oauth.ts",
      "types": "./dist/entries/identity-providers/generic-oauth.d.ts",
      "default": "./dist/entries/identity-providers/generic-oauth.js"
    }
  },
  "imports": {
    "#backend/*": {
      "@tinyauth/source": "./src/*",
      "types": "./dist/*",
      "default": "./dist/*"
    }
  },
  "scripts": {
    "test": "NODE_OPTIONS='--conditions=@tinyauth/source --import tsx' vitest",
    "test:coverage": "NODE_OPTIONS='--conditions=@tinyauth/source --import tsx' vitest run --coverage",
    "clean": "rm -rf dist node_modules/.cache/tsconfig.src.tsbuildinfo node_modules/.cache/tsconfig.test.tsbuildinfo publish",
    "build": "npm run clean && tsc -b tsconfig.json",
    "build:watch": "tsc -b -w tsconfig.json",
    "email:preview": "email dev --dir src/emails/templates --port 3001",
    "mikro-orm": "NODE_OPTIONS='--conditions=@tinyauth/source --import tsx' mikro-orm",
    "mikro-orm:compile": "NODE_OPTIONS='--conditions=@tinyauth/source --import tsx' mikro-orm compile",
    "mikro-orm:debug": "NODE_OPTIONS='--conditions=@tinyauth/source --import tsx' mikro-orm debug",
    "mikro-orm:schema:create": "NODE_OPTIONS='--conditions=@tinyauth/source --import tsx' mikro-orm migration:create --initial"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@react-email/preview-server": "5.2.7",
    "@types/node": "catalog:",
    "@types/nodemailer": "^7.0.9",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "^4.0.18",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.2.2",
    "@mikro-orm/cli": "^7.0.0-rc.3",
    "@mikro-orm/core": "^7.0.0-rc.3",
    "@mikro-orm/decorators": "^7.0.0-rc.3",
    "@mikro-orm/migrations": "^7.0.0-rc.3",
    "@mikro-orm/postgresql": "^7.0.0-rc.3",
    "@mikro-orm/seeder": "^7.0.0-rc.3",
    "@mikro-orm/sqlite": "^7.0.0-rc.3",
    "@react-email/components": "^1.0.7",
    "@react-email/render": "^2.0.4",
    "@react-email/tailwind": "^2.0.4",
    "@scalar/hono-api-reference": "^0.5.175",
    "@simplewebauthn/server": "^13.2.2",
    "croner": "^10.0.1",
    "hono": "catalog:",
    "hono-openapi": "^1.2.0",
    "jose": "catalog:",
    "pino-pretty": "^13.1.3",
    "react-email": "^5.2.7",
    "nodemailer": "^8.0.0",
    "otplib": "^13.2.1",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "catalog:",
    "zod": "catalog:"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/entries/database/cli.ts",
      "./dist/entries/database/cli.js"
    ]
  }
}
