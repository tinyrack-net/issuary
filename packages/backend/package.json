{
  "name": "@tinyauth/backend",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "license": "AGPL-3.0-only",
  "main": "dist/cli.js",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/cli.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "default": "./dist/rpc.js"
    }
  },
  "bin": {
    "tinyauth": "./dist/cli.js"
  },
  "scripts": {
    "dev": "APP_ENV=development CONFIG_PATH=./config.dev.minimal.yaml tsx watch --include './src/**/*' --include ./config.dev.yaml src/cli.ts serve",
    "dev:maximal": "APP_ENV=development CONFIG_PATH=./config.dev.yaml tsx watch --include './src/**/*' --include ./config.dev.yaml src/cli.ts serve",
    "dev:cli": "APP_ENV=development CONFIG_PATH=./config.dev.yaml tsx src/cli.ts",
    "test": "APP_ENV=test NODE_OPTIONS='--import tsx' vitest",
    "start": "node dist/cli.js serve",
    "build": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
    "build:watch": "tsc -w",
    "serve": "APP_ENV=production node dist/cli.js serve",
    "job": "APP_ENV=production node dist/cli.js job",
    "mikro-orm": "NODE_OPTIONS='--import tsx' mikro-orm ",
    "mikro-orm:debug": "NODE_OPTIONS='--import tsx' mikro-orm debug",
    "mikro-orm:schema:create": "NODE_OPTIONS='--import tsx' mikro-orm migration:create --initial",
    "export:openapi": "APP_ENV=test NODE_OPTIONS='--import tsx' tsx src/export-openapi.ts",
    "email:preview": "email dev --dir src/emails/templates --port 3001"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@mikro-orm/cli": "^7.0.0-rc.1",
    "@react-email/preview-server": "5.2.7",
    "@types/node": "catalog:",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-email": "^5.2.7",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.3",
    "@hono/zod-openapi": "^1.2.1",
    "@mikro-orm/core": "^7.0.0-rc.1",
    "@mikro-orm/decorators": "^7.0.0-rc.1",
    "@mikro-orm/migrations": "^7.0.0-rc.1",
    "@mikro-orm/postgresql": "^7.0.0-rc.1",
    "@mikro-orm/seeder": "^7.0.0-rc.1",
    "@mikro-orm/sqlite": "^7.0.0-rc.1",
    "@node-rs/argon2": "^2.0.2",
    "@react-email/components": "^1.0.7",
    "@react-email/render": "^2.0.4",
    "@react-email/tailwind": "^2.0.4",
    "@scalar/hono-api-reference": "^0.5.175",
    "@simplewebauthn/server": "^13.2.2",
    "@types/nodemailer": "^7.0.9",
    "commander": "^14.0.3",
    "croner": "^10.0.1",
    "dotenv": "^17.2.4",
    "hono": "^4.8.3",
    "jose": "catalog:",
    "nodemailer": "^8.0.0",
    "otplib": "^13.2.1",
    "pg": "^8.18.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "yaml": "^2.8.2",
    "zod": "catalog:"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/db/cli.ts",
      "./dist/db/cli.js"
    ]
  }
}
