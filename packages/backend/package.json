{
  "name": "@tinyauth/backend",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "license": "AGPL-3.0-only",
  "main": "dist/index.js",
  "bin": {
    "tinyauth": "./dist/index.js"
  },
  "scripts": {
    "dev": "APP_ENV=development CONFIG_PATH=./config.dev.yaml tsx watch --include './src/**/*' --include ./config.dev.yaml src/index.ts serve",
    "dev:cli": "APP_ENV=development CONFIG_PATH=./config.dev.yaml tsx src/index.ts",
    "test": "APP_ENV=test NODE_OPTIONS='--import tsx' vitest",
    "start": "node dist/index.js serve",
    "build": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
    "build:watch": "tsc -w",
    "serve": "APP_ENV=production node dist/index.js serve",
    "job": "APP_ENV=production node dist/index.js job",
    "mikro-orm": "NODE_OPTIONS='--import tsx' mikro-orm-esm ",
    "mikro-orm:debug": "NODE_OPTIONS='--import tsx' mikro-orm-esm debug",
    "mikro-orm:schema:create": "NODE_OPTIONS='--import tsx' mikro-orm-esm migration:create --initial",
    "export:openapi": "APP_ENV=test NODE_OPTIONS='--import tsx' tsx src/export-openapi.ts",
    "email:preview": "email dev --dir src/emails/templates --port 3001"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@mikro-orm/cli": "^6.6.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-email": "^5.2.7",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/secure-session": "^8.3.0",
    "@fastify/static": "^9.0.0",
    "@fastify/swagger": "^9.6.1",
    "@mikro-orm/core": "^6.6.6",
    "@mikro-orm/libsql": "^6.6.6",
    "@mikro-orm/migrations": "^6.6.6",
    "@mikro-orm/postgresql": "^6.6.6",
    "@mikro-orm/seeder": "^6.6.6",
    "@node-rs/argon2": "^2.0.2",
    "@react-email/components": "^1.0.7",
    "@react-email/render": "^2.0.4",
    "@react-email/tailwind": "^2.0.4",
    "@scalar/fastify-api-reference": "^1.44.14",
    "@simplewebauthn/server": "^13.2.2",
    "@types/nodemailer": "^7.0.9",
    "commander": "^14.0.3",
    "croner": "^10.0.1",
    "dotenv": "^17.2.4",
    "fastify": "^5.7.4",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "jose": "catalog:",
    "nodemailer": "^8.0.0",
    "otplib": "^13.2.1",
    "pg": "^8.18.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "yaml": "^2.8.2",
    "zod": "catalog:"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/db/cli.ts",
      "./dist/db/cli.js"
    ]
  }
}
