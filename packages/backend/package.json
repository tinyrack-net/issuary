{
  "name": "@tinyauth/backend",
  "version": "1.0.0",
  "type": "module",
  "description": "OpenID Connect Provider with OAuth2 support",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://git.winetree94.com/tinyrack/auth.git",
    "directory": "packages/backend"
  },
  "files": [
    "public",
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "imports": {
      "#backend/*": {
        "types": "./dist/*",
        "default": "./dist/*"
      }
    }
  },
  "exports": {
    ".": {
      "@tinyauth/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#backend/*": {
      "@tinyauth/source": "./src/*",
      "types": "./dist/*",
      "default": "./dist/*"
    }
  },
  "bin": {
    "tinyauth": "./dist/cli.js"
  },
  "scripts": {
    "dev": "CONFIG_PATH=./config.dev.yaml NODE_OPTIONS='--conditions=@tinyauth/source' tsx watch --include './src/**/*' --include ./config.dev.yaml src/cli.ts serve",
    "dev:cli": "CONFIG_PATH=./config.dev.yaml NODE_OPTIONS='--conditions=@tinyauth/source' tsx src/cli.ts",
    "test": "NODE_OPTIONS='--conditions=@tinyauth/source --import tsx' vitest",
    "test:coverage": "NODE_OPTIONS='--conditions=@tinyauth/source --import tsx' vitest run --coverage",
    "start": "node dist/cli.js serve",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc -w",
    "serve": "node dist/cli.js serve",
    "job": "node dist/cli.js job",
    "mikro-orm": "NODE_OPTIONS='--conditions=@tinyauth/source --import tsx' mikro-orm",
    "mikro-orm:compile": "NODE_OPTIONS='--conditions=@tinyauth/source --import tsx' mikro-orm compile",
    "mikro-orm:debug": "NODE_OPTIONS='--conditions=@tinyauth/source --import tsx' mikro-orm debug",
    "mikro-orm:schema:create": "NODE_OPTIONS='--conditions=@tinyauth/source --import tsx' mikro-orm migration:create --initial",
    "export:openapi": "NODE_OPTIONS='--conditions=@tinyauth/source --import tsx' tsx src/cli.ts export:openapi",
    "openapi:export": "pnpm export:openapi",
    "email:preview": "email dev --dir src/emails/templates --port 3001"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@mikro-orm/cli": "^7.0.0-rc.2",
    "@react-email/preview-server": "5.2.7",
    "@types/node": "catalog:",
    "@types/nodemailer": "^7.0.9",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "^4.0.18",
    "pino-pretty": "^13.1.3",
    "react-email": "^5.2.7",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@hono/standard-validator": "^0.2.2",
    "@mikro-orm/core": "^7.0.0-rc.2",
    "@mikro-orm/decorators": "^7.0.0-rc.2",
    "@mikro-orm/migrations": "^7.0.0-rc.2",
    "@mikro-orm/postgresql": "^7.0.0-rc.2",
    "@mikro-orm/seeder": "^7.0.0-rc.2",
    "@mikro-orm/sqlite": "^7.0.0-rc.2",
    "@node-rs/argon2": "^2.0.2",
    "@react-email/components": "^1.0.7",
    "@react-email/render": "^2.0.4",
    "@react-email/tailwind": "^2.0.4",
    "@scalar/hono-api-reference": "^0.5.175",
    "@simplewebauthn/server": "^13.2.2",
    "commander": "^14.0.3",
    "croner": "^10.0.1",
    "dotenv": "^17.2.4",
    "hono": "catalog:",
    "hono-openapi": "^1.2.0",
    "jose": "catalog:",
    "nodemailer": "^8.0.0",
    "otplib": "^13.2.1",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "catalog:",
    "yaml": "^2.8.2",
    "zod": "catalog:"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/db/cli.ts",
      "./dist/db/cli.js"
    ]
  }
}
