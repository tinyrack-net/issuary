# OpenID Connect Configuration
# The issuer URL of your OIDC provider
VITE_OIDC_ISSUER=http://localhost:8080

# OAuth Client ID (Public Client - no secret required)
VITE_OIDC_CLIENT_ID=react-spa-client

# Redirect URI (must match client registration)
VITE_OIDC_REDIRECT_URI=http://localhost:3001/callback

# OAuth Scopes (space-separated)
VITE_OIDC_SCOPE=openid profile email
