{
  "name": "@tinyrack/issuary-tools",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "bin": {
    "issuary-tools": "./src/cli.ts"
  },
  "imports": {
    "#tools/*.ts": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "#tools/*": {
      "types": "./src/*",
      "default": "./src/*"
    }
  },
  "scripts": {
    "dev": "node --conditions=@issuary/source src/cli.ts",
    "test": "node --conditions=@issuary/source node_modules/vitest/vitest.mjs",
    "test:coverage": "node --conditions=@issuary/source node_modules/vitest/vitest.mjs run --coverage",
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch"
  },
  "dependencies": {
    "@stricli/core": "catalog:",
    "consola": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
