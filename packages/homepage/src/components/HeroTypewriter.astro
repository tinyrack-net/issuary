---
interface Props {
  prefix?: string;
  suffix?: string;
  words: string[];
  docsLink: string;
  docsLabel: string;
}

const { prefix, suffix, words, docsLink, docsLabel } = Astro.props;
---

<div
  class="flex flex-col items-center text-center gap-6 p-8"
  data-words={JSON.stringify(words)}
>
  <svg
    class="w-20 h-20 opacity-85"
    style="color: var(--sl-color-text-accent);"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 256 256"
    fill="none"
    stroke="currentColor"
    stroke-width="12"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M128 24L32 72v56c0 52.37 40.73 100.86 96 112 55.27-11.14 96-59.63 96-112V72Z" />
    <rect x="96" y="112" width="64" height="48" rx="4" />
    <path d="M112 112V88a16 16 0 0 1 32 0v24" />
    <circle cx="128" cy="136" r="4" fill="currentColor" stroke="none" />
  </svg>
  <h1
    class="text-[clamp(0.94rem,3vw,1.5rem)] font-bold whitespace-nowrap m-0"
    style="color: var(--sl-color-white);"
  >
    {prefix && <span>{prefix}</span>}
    <span
      class="typewriter"
      style="color: var(--sl-color-text-accent);"
    ></span>
    <span
      class="cursor font-normal"
      style="color: var(--sl-color-text-accent);"
    >|</span>
    {suffix && <span>{suffix}</span>}
  </h1>
  <a
    href={docsLink}
    class="inline-flex items-center gap-2 px-5 py-2 text-sm font-medium rounded-md no-underline transition-colors"
    style="background: var(--sl-color-text-accent); color: var(--sl-color-black);"
  >
    {docsLabel}
    <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
    </svg>
  </a>
</div>

<style>
  .cursor {
    animation: blink 0.7s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-words]').forEach((container) => {
    const raw = container.dataset.words;
    if (!raw) return;

    const words: string[] = JSON.parse(raw);
    const typewriterEl = container.querySelector<HTMLElement>('.typewriter');
    if (!typewriterEl || words.length === 0) return;
    const el = typewriterEl;

    let wordIndex = 0;
    let charIndex = 0;
    let isDeleting = false;

    function tick() {
      const currentWord = words[wordIndex]!;

      if (!isDeleting) {
        charIndex++;
        el.textContent = currentWord.substring(0, charIndex);
        if (charIndex === currentWord.length) {
          isDeleting = true;
          setTimeout(tick, 1500);
          return;
        }
        setTimeout(tick, 100);
      } else {
        charIndex--;
        el.textContent = currentWord.substring(0, charIndex);
        if (charIndex === 0) {
          isDeleting = false;
          wordIndex = (wordIndex + 1) % words.length;
          setTimeout(tick, 300);
          return;
        }
        setTimeout(tick, 60);
      }
    }

    tick();
  });
</script>
