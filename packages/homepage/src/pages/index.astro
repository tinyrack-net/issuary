---
import { Card, CardGrid } from '@astrojs/starlight/components';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
  frontmatter={{
    title: 'Tinyrack Auth',
    description: 'A lightweight OpenID Connect (OIDC) Provider for modern applications',
    template: 'splash',
    hero: {
      tagline: 'Secure authentication made simple. A complete OAuth2/OIDC solution for your applications.',
      actions: [
        { text: 'Get Started', link: '/getting-started/introduction/', icon: 'right-arrow' },
        { text: 'View on GitHub', link: 'https://github.com/tinyrack/auth', icon: 'external', variant: 'minimal' },
      ],
    },
  }}
>
  <h2>Features</h2>

  <CardGrid stagger>
    <Card title="OAuth2 & OIDC" icon="approve-check">
      Full implementation of OAuth2 and OpenID Connect protocols with support for Authorization Code Flow with PKCE.
    </Card>
    <Card title="Multiple Auth Methods" icon="setting">
      Support for password-based authentication, WebAuthn/Passkeys, TOTP 2FA, and social login (Google, GitHub, Apple).
    </Card>
    <Card title="Multi-language Support" icon="translate">
      Built-in internationalization with Korean, English, and Japanese language support.
    </Card>
    <Card title="Modern Stack" icon="rocket">
      Built with Fastify, React, TanStack Router, and Tailwind CSS for optimal performance.
    </Card>
  </CardGrid>
</StarlightPage>
