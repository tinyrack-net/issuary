{
  "name": "@tinyrack/issuary-homepage",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "generate:openapi": "node --conditions=@issuary/source --import tsx node_modules/@tinyrack/issuary-standalone/src/cli.ts export openapi public/openapi.json",
    "dev": "pnpm generate:openapi && react-router dev",
    "build": "pnpm generate:openapi && react-router build",
    "check:ui": "tinyrack-ui-check",
    "preview": "vite preview",
    "preview:worker": "wrangler dev",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:quick": "pnpm generate:openapi && vitest run --exclude tests/browser.test.ts",
    "test:audit": "vitest run tests/browser.test.ts",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@react-router/node": "8.3.0",
    "@scalar/api-reference-react": "0.9.55",
    "@tinyrack/docs": "0.21.0",
    "@tinyrack/ui": "0.27.0",
    "isbot": "5.2.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "8.3.0",
    "shiki": "4.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@react-router/dev": "8.3.0",
    "@tailwindcss/vite": "catalog:",
    "@tinyrack/issuary-standalone": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "playwright": "1.61.1",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
