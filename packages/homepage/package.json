{
  "name": "@tinyauth/homepage",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "imports": {
    "#homepage/*": {
      "types": "./src/*",
      "default": "./src/*"
    }
  },
  "scripts": {
    "generate:openapi": "NODE_OPTIONS='--conditions=@tinyauth/source' tsx node_modules/@tinyauth/standalone/src/cli.ts export:openapi public/openapi.json",
    "dev": "pnpm generate:openapi && astro dev",
    "build": "pnpm generate:openapi && astro check && astro build",
    "preview": "astro preview",
    "preview:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.37.6",
    "@astrojs/starlight-tailwind": "^4.0.2",
    "@scalar/astro": "^0.1.16",
    "@tailwindcss/vite": "catalog:",
    "astro": "^5.17.1",
    "sharp": "^0.34.5",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@biomejs/biome": "catalog:",
    "@tinyauth/standalone": "workspace:*",
    "wrangler": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
