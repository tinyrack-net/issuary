{
  "name": "@tinyrack/tinyauth-homepage",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "imports": {
    "#homepage/*": {
      "types": "./src/*",
      "default": "./src/*"
    }
  },
  "scripts": {
    "generate:openapi": "node --conditions=@tinyauth/source --import tsx node_modules/@tinyrack/tinyauth-standalone/src/cli.ts export openapi public/openapi.json",
    "dev": "pnpm generate:openapi && astro dev",
    "build": "pnpm generate:openapi && astro check && astro build",
    "preview": "astro preview",
    "preview:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/starlight": "catalog:",
    "@astrojs/starlight-tailwind": "catalog:",
    "@scalar/astro": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "astro": "catalog:",
    "sharp": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@biomejs/biome": "catalog:",
    "@tinyrack/tinyauth-standalone": "workspace:*",
    "wrangler": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
