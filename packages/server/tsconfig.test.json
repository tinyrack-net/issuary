{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.test.tsbuildinfo"
  },
  "references": [{ "path": "./tsconfig.src.json" }],
  "include": [
    "src/**/*.test.ts",
    "src/**/.*/**/*.test.ts",
    "src/test-utils/**/*",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
