{
  "name": "@tinyrack/tinyauth-standalone",
  "version": "0.4.0",
  "type": "module",
  "description": "TinyAuth standalone CLI server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://git.winetree94.com/tinyrack/tinyauth.git",
    "directory": "packages/standalone"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "imports": {
      "#standalone/*.ts": "./dist/*.js",
      "#standalone/*": {
        "types": "./dist/*",
        "default": "./dist/*"
      }
    }
  },
  "imports": {
    "#standalone/*.ts": {
      "@tinyauth/source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "#standalone/*": {
      "@tinyauth/source": "./src/*",
      "types": "./dist/*",
      "default": "./dist/*"
    }
  },
  "bin": {
    "tinyauth": "./dist/cli.js"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--conditions=@tinyauth/source tsx watch --include './src/**/*' --include ./config.dev.yaml src/cli.ts serve --config-path='./config.dev.yaml'",
    "dev:cli": "cross-env CONFIG_PATH=./config.dev.yaml NODE_OPTIONS=--conditions=@tinyauth/source tsx src/cli.ts",
    "docker:build": "docker build -f ./Dockerfile ../.. -t tinyauth:local",
    "test": "node --conditions=@tinyauth/source node_modules/vitest/vitest.mjs --exclude e2e/dist-cli.e2e.test.ts",
    "test:coverage": "node --conditions=@tinyauth/source node_modules/vitest/vitest.mjs run --coverage --exclude e2e/dist-cli.e2e.test.ts",
    "test:dist": "pnpm --filter @tinyrack/tinyauth-server run build && pnpm run build && vitest run e2e/dist-cli.e2e.test.ts",
    "clean": "node ../../packages/tools/src/scripts/rm.ts dist node_modules/.cache/tsconfig.src.tsbuildinfo node_modules/.cache/tsconfig.src.build.tsbuildinfo node_modules/.cache/tsconfig.test.tsbuildinfo node_modules/.cache/tsconfig.e2e.tsbuildinfo",
    "build": "pnpm run clean && tsc -b tsconfig.build.json",
    "build:watch": "tsc -b -w tsconfig.json",
    "cli": "node dist/cli.js",
    "export:openapi": "node --conditions=@tinyauth/source --import tsx src/cli.ts export openapi"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "execa": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "cross-env": "catalog:"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@mikro-orm/cli": "catalog:",
    "@stricli/core": "catalog:",
    "@tinyrack/tinyauth-server": "workspace:*",
    "croner": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "hono-openapi": "catalog:",
    "nodemailer": "catalog:",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  }
}
