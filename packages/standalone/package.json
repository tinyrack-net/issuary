{
  "name": "@tinyauth/standalone",
  "version": "1.0.0",
  "type": "module",
  "description": "TinyAuth standalone CLI server",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://git.winetree94.com/tinyrack/tinyauth.git",
    "directory": "packages/standalone"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      "./config": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      },
      "./app": {
        "types": "./dist/app.d.ts",
        "default": "./dist/app.js"
      }
    },
    "imports": {
      "#standalone/*": {
        "types": "./dist/*",
        "default": "./dist/*"
      }
    }
  },
  "exports": {
    "./config": {
      "@tinyauth/source": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./app": {
      "@tinyauth/source": "./src/app.ts",
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "imports": {
    "#standalone/*": {
      "@tinyauth/source": "./src/*",
      "types": "./dist/*",
      "default": "./dist/*"
    }
  },
  "bin": {
    "tinyauth": "./dist/cli.js"
  },
  "oclif": {
    "bin": "tinyauth",
    "dirname": "tinyauth",
    "commands": {
      "strategy": "pattern",
      "target": "./dist/cli/commands",
      "globPatterns": [
        "**/*.js"
      ]
    },
    "topicSeparator": ":"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--conditions=@tinyauth/source' tsx watch --include './src/**/*' --include ./config.dev.yaml src/cli.ts serve --config-path='./config.dev.yaml'",
    "dev:cli": "CONFIG_PATH=./config.dev.yaml NODE_OPTIONS='--conditions=@tinyauth/source' tsx src/cli.ts",
    "test": "NODE_OPTIONS='--conditions=@tinyauth/source' vitest",
    "test:coverage": "NODE_OPTIONS='--conditions=@tinyauth/source' vitest run --coverage",
    "clean": "rm -rf dist node_modules/.cache/tsconfig.src.tsbuildinfo node_modules/.cache/tsconfig.src.build.tsbuildinfo node_modules/.cache/tsconfig.test.tsbuildinfo node_modules/.cache/tsconfig.e2e.tsbuildinfo",
    "build": "npm run clean && tsc -b tsconfig.build.json",
    "build:watch": "tsc -b -w tsconfig.json",
    "cli": "node dist/cli.js",
    "export:openapi": "NODE_OPTIONS='--conditions=@tinyauth/source' tsx src/cli.ts export:openapi"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "execa": "^9.6.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@mikro-orm/cli": "catalog:",
    "@oclif/core": "^4.9.0",

    "@tinyauth/backend": "workspace:*",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "hono-openapi": "catalog:",
    "nodemailer": "catalog:",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  }
}
