{
  "name": "@tinyauth/standalone",
  "version": "1.0.0",
  "type": "module",
  "description": "TinyAuth standalone CLI server",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://git.winetree94.com/tinyrack/auth.git",
    "directory": "packages/standalone"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      "./config": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      },
      "./app": {
        "types": "./dist/app.d.ts",
        "default": "./dist/app.js"
      }
    },
    "imports": {
      "#standalone/*": {
        "types": "./dist/*",
        "default": "./dist/*"
      }
    }
  },
  "exports": {
    "./config": {
      "@tinyauth/source": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./app": {
      "@tinyauth/source": "./src/app.ts",
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "imports": {
    "#standalone/*": {
      "@tinyauth/source": "./src/*",
      "types": "./dist/*",
      "default": "./dist/*"
    }
  },
  "bin": {
    "tinyauth": "./dist/cli.js"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--conditions=@tinyauth/source' tsx watch --include './src/**/*' --include ./config.dev.yaml src/cli.ts serve --config-path='./config.dev.yaml'",
    "dev:cli": "CONFIG_PATH=./config.dev.yaml NODE_OPTIONS='--conditions=@tinyauth/source' tsx src/cli.ts",
    "test": "NODE_OPTIONS='--conditions=@tinyauth/source --import tsx' vitest",
    "clean": "rm -rf dist node_modules/.cache/tsconfig.src.tsbuildinfo node_modules/.cache/tsconfig.test.tsbuildinfo",
    "build": "npm run clean && tsc -b tsconfig.json",
    "build:watch": "tsc -b -w tsconfig.json",
    "cli": "node dist/cli.js",
    "mikro-orm": "NODE_OPTIONS='--conditions=@tinyauth/source --import tsx' mikro-orm",
    "mikro-orm:compile": "NODE_OPTIONS='--conditions=@tinyauth/source --import tsx' mikro-orm compile",
    "mikro-orm:debug": "NODE_OPTIONS='--conditions=@tinyauth/source --import tsx' mikro-orm debug",
    "mikro-orm:schema:create": "NODE_OPTIONS='--conditions=@tinyauth/source --import tsx' mikro-orm migration:create --initial",
    "export:openapi": "NODE_OPTIONS='--conditions=@tinyauth/source --import tsx' tsx src/cli.ts export:openapi"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "@types/nodemailer": "^7.0.9",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@tinyauth/backend": "workspace:*",
    "@hono/node-server": "catalog:",
    "@mikro-orm/cli": "^7.0.0-rc.2",
    "commander": "^14.0.3",
    "dotenv": "^17.2.4",
    "hono": "catalog:",
    "hono-openapi": "^1.2.0",
    "nodemailer": "^8.0.0",
    "yaml": "^2.8.2",
    "zod": "catalog:"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/db/cli.ts",
      "./dist/db/cli.js"
    ]
  }
}
