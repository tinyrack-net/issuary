{
  "name": "@tinyauth/frontend",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "imports": {
    "#frontend/*": {
      "types": "./src/*",
      "default": "./src/*"
    },
    "#frontend-e2e/*": {
      "types": "./e2e/*",
      "default": "./e2e/*"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:build": "vite build --watch",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest --project unit",
    "test:unit:coverage": "VITEST_COVERAGE=1 vitest run --project unit --coverage",
    "test:coverage": "pnpm run test:unit:coverage",
    "test:unit:ui": "vitest --ui",
    "test:unit:preview": "VITEST_BROWSER_MODE=preview vitest",
    "test:e2e": "NODE_OPTIONS='--conditions=@tinyauth/source --import tsx' playwright test",
    "test:e2e:smoke": "NODE_OPTIONS='--conditions=@tinyauth/source --import tsx' playwright test --project minimal:chromium",
    "test:e2e:ui": "NODE_OPTIONS='--conditions=@tinyauth/source --import tsx' playwright test --ui"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@simplewebauthn/browser": "^13.2.2",
    "@tailwindcss/typography": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "hono": "catalog:",
    "i18next": "^25.8.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.71.1",
    "react-i18next": "^16.5.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@hono/node-server": "catalog:",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@tinyauth/backend": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/nodemailer": "catalog:",
    "nodemailer": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/browser-preview": "catalog:",
    "@vitest/ui": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "daisyui": "catalog:",
    "otplib": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  }
}
