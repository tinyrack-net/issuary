{
  "name": "@tinyrack/issuary-frontend",
  "private": true,
  "version": "0.26.0",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#frontend/*.ts": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "#frontend/*.tsx": {
      "types": "./src/*.tsx",
      "default": "./src/*.tsx"
    },
    "#frontend/*": {
      "types": "./src/*",
      "default": "./src/*"
    },
    "#frontend-e2e/*.ts": {
      "types": "./e2e/*.ts",
      "default": "./e2e/*.ts"
    },
    "#frontend-e2e/*.tsx": {
      "types": "./e2e/*.tsx",
      "default": "./e2e/*.tsx"
    },
    "#frontend-e2e/*": {
      "types": "./e2e/*",
      "default": "./e2e/*"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:build": "vite build --watch",
    "build": "tsc -b tsconfig.build.json && tsc -p tsconfig.e2e.json && vite build",
    "build:e2e": "vite build",
    "check:ui": "tinyrack-ui-check",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.e2e.json",
    "preview": "vite preview",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest --project unit",
    "test:unit:chromium": "cross-env VITEST_BROWSER_SET=chromium vitest --project unit",
    "test:unit:coverage": "cross-env VITEST_COVERAGE=1 vitest run --project unit --coverage",
    "test:coverage": "pnpm run test:unit:coverage",
    "test:unit:ui": "vitest --ui",
    "test:unit:preview": "cross-env VITEST_BROWSER_MODE=preview vitest",
    "test:e2e": "node --import tsx node_modules/@playwright/test/cli.js test",
    "test:e2e:sharded": "node e2e/run-sharded.ts",
    "test:e2e:smoke": "node --import tsx node_modules/@playwright/test/cli.js test --project minimal:chromium",
    "test:e2e:smoke:source": "node --conditions=@issuary/source --import tsx node_modules/@playwright/test/cli.js test --project minimal:chromium",
    "test:e2e:smoke:sharded": "node e2e/run-sharded.ts --project minimal:chromium",
    "test:e2e:screen": "node --import tsx node_modules/@playwright/test/cli.js test --project screen-lab:chromium",
    "test:e2e:ui": "node --conditions=@issuary/source --import tsx node_modules/@playwright/test/cli.js test --ui",
    "screen:dev": "node --conditions=@issuary/source --import tsx e2e/screen-lab/screen-dev.ts"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-jp": "5.3.0",
    "@fontsource/ibm-plex-sans-kr": "5.3.0",
    "@hookform/resolvers": "catalog:",
    "@simplewebauthn/browser": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "hono": "catalog:",
    "i18next": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-i18next": "catalog:",
    "@tinyrack/ui": "0.29.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@hono/node-server": "catalog:",
    "@playwright/test": "catalog:",
    "@rolldown/plugin-babel": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@tinyrack/issuary-server": "workspace:*",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/browser-preview": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "@axe-core/playwright": "4.12.1",
    "nodemailer": "catalog:",
    "otplib": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:",
    "cross-env": "catalog:"
  }
}
