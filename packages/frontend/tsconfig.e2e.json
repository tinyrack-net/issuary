{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.e2e.tsbuildinfo",
    "paths": {
      "#frontend-e2e/*": ["./e2e/*"]
    }
  },
  "include": [
    "playwright.config.ts",
    "e2e/tests",
    "e2e/helpers",
    "e2e/fixtures",
    "e2e/setup",
    "e2e/configs"
  ]
}
