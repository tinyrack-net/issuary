{
  "name": "@tinyauth/example-cloudflare-worker-hono",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @tinyauth/frontend build && vite",
    "build": "pnpm --filter @tinyauth/frontend build && tsc --noEmit && vite build",
    "preview": "pnpm run build && vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "test": "NODE_OPTIONS='--conditions=@tinyauth/source' vitest run"
  },
  "dependencies": {
    "@tinyauth/backend": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@types/node": "catalog:",
    "hono": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
