{
  "name": "@issuary-client-examples/react-spa",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#example-react-spa/*.ts": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "#example-react-spa/*.tsx": {
      "types": "./src/*.tsx",
      "default": "./src/*.tsx"
    },
    "#example-react-spa/*": {
      "types": "./src/*",
      "default": "./src/*"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:ui": "tinyrack-ui-check",
    "typecheck": "tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tinyrack/ui": "0.25.0",
    "jose": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",

    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
