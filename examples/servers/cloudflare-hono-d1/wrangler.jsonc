{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tinyauth-cloudflare-hono-d1-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-06",
  "compatibility_flags": ["nodejs_compat", "allow_insecure_inefficient_logged_eval"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tinyauth-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "assets": {
    "directory": "../../packages/backend/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*"]
  }
}

